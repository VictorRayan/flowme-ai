# ============================================================
# Supabase
# Get from: https://supabase.com/dashboard → Project Settings → API
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================================
# Google OAuth (SAME credentials used in both places)
#
# 1. Google Cloud Console: https://console.cloud.google.com
#    → APIs & Services → Credentials → OAuth 2.0 Client ID
#
# 2. Supabase Dashboard: Authentication → Providers → Google
#    → Paste the SAME Client ID and Client Secret there
#    → Set the Supabase callback URL in Google Cloud Console:
#      https://<your-project-ref>.supabase.co/auth/v1/callback
#
# Google Cloud Console → Authorized redirect URIs must include BOTH:
#   - https://<your-project-ref>.supabase.co/auth/v1/callback  (for Supabase Google login)
#   - http://localhost:3000/api/auth/google/callback            (for linking additional accounts)
# ============================================================
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ============================================================
# App
# ============================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
